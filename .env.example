# TickITFlow — Variables de entorno para Docker Compose
# Copia este archivo a .env y ajusta los valores para tu entorno.
# .env está en .gitignore (no se versiona).

# PostgreSQL (todas las bases)
POSTGRES_PASSWORD=cambiar-por-un-password-seguro

# JWT (compartido entre los 7 servicios para firmar/verificar tokens)
JWT_SECRET=cambiar-por-un-secret-largo-y-aleatorio-minimo-32-caracteres

# RabbitMQ
RABBITMQ_USER=tickit
RABBITMQ_PASS=cambiar-por-un-password-seguro

# Grafana
GRAFANA_ADMIN_USER=tickit
GRAFANA_ADMIN_PASS=cambiar-por-un-password-seguro

# Zot Registry (para publicar imágenes desde CI)
# ZOT_REGISTRY=registry.edrs.xyz
# ZOT_CI_USER=tu-usuario
# ZOT_CI_PASSWORD=tu-password

# MinIO (almacenamiento S3-compatible para adjuntos)
MINIO_USER=tickit
MINIO_PASSWORD=cambiar-por-un-password-seguro
